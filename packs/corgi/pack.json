    "thinking": { "row": 3, "frames": 4, "fps": 3, "loop": true },
    "happy":    { "row": 4, "frames": 4, "fps": 6, "loop": true },
    "sad":      { "row": 6, "frames": 4, "fps": 3, "loop": true }
  },
  "states": {
    "idle": "idle",
