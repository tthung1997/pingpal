{
  "schema": 2,
  "id": "pip",
  "name": "Pip",
  "author": "PingPal",
  "description": "Placeholder blob. Idles, and now and then naps, plays or dances for a moment.",
  "sheet": "sheet.png",
  "frame_size": [32, 32],
  "anchor": [16, 30],
  "head": [16, 6],
  "behavior": {
    "idle_seconds": [6.0, 14.0],
    "break_seconds": [3.0, 6.0],
    "breaks": ["sleep", "play", "dance"]
  },
  "animations": {
    "idle":     { "row": 0, "frames": 4, "fps": 3,  "loop": true },
    "sleep":    { "row": 2, "frames": 4, "fps": 2,  "loop": true },
    "play":     { "row": 3, "frames": 4, "fps": 8,  "loop": true },
    "alert":    { "row": 5, "frames": 4, "fps": 6,  "loop": true },
    "dance":    { "row": 9, "frames": 4, "fps": 8,  "loop": true }
  },
  "states": {
    "idle": "idle",
    "attention": "alert",
    "sleep": "sleep",
    "play": "play",
    "dance": "dance"
  }
}
